#!/usr/bin/env bash
# Refuse moving refs/heads/main to a commit origin/main does not contain (prepared phase).
# Skips silently when scripts/guard_main.sh is absent.
set -euo pipefail
guard="$(cd "$(dirname "$0")/.." && pwd -P)/scripts/guard_main.sh"
[ -f "$guard" ] || exit 0
# shellcheck source=scripts/guard_main.sh
. "$guard"
guard_main_ff "${1:-}"
